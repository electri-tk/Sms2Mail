<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SMS Yönlendirici Ayarları"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="32dp"/>

    <EditText
        android:id="@+id/editSenderMail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Gönderen Gmail Adresi"
        android:inputType="textEmailAddress" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editPasswordYeni"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Uygulama Şifresi"
            android:inputType="textPassword" />

    </com.google.android.material.textfield.TextInputLayout>

    <EditText
        android:id="@+id/editReceiverMail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Alıcı E-posta Adresi"
        android:inputType="textEmailAddress"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ayarları Kaydet"
        android:layout_marginBottom="24dp"/>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchService"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Servisi Başlat" />

</LinearLayout>